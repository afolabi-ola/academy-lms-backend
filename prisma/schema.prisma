generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model Slider {
  id          Int      @id @default(autoincrement())
  image    String
  title     String
  description String
  isActive  Boolean?  @default(true)
  createdAt   DateTime @default(now())
}

model Faq {
  id        Int      @id @default(autoincrement())
  question  String
  answer    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Student {
  id             Int      @id @default(autoincrement())
  surname        String
  firstname      String
  otherName      String
  dateOfBirth    DateTime
  email          String   @unique
  phone          String
  address        String
  photo          String?
  parentName     String
  parentsPhone   String
  parentsAddress String
  createdAt      DateTime @default(now())

  courses  Course[] 
  payments Payment[]
}

model Course {
  id          Int      @id @default(autoincrement())
  image    String
  title       String
  description String
  duration    String
  fee      Float
  isActive    Boolean?  @default(true)
  createdAt   DateTime @default(now())

  students Student[]
}

model Payment {
  id        Int      @id @default(autoincrement())
  amount    Float
  reference String   @unique @default(uuid())
  status    String
  createdAt DateTime @default(now())

  student   Student  @relation(fields: [studentId], references: [id])
  studentId Int
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role @default(SUB_ADMIN)
  createdAt DateTime @default(now())
}

enum Role {
  ADMIN
  SUB_ADMIN
}

generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model Slider {
  id          Int      @id @default(autoincrement())
  image    String
  title     String
  publicId  String
  description String
  isActive  Boolean?  @default(true)
  createdAt   DateTime @default(now())
}

model Faq {
  id        Int      @id @default(autoincrement())
  question  String
  answer    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Student {
  id             Int      @id @default(autoincrement())
  surname        String
  firstname      String
  otherName      String
  dateOfBirth    DateTime
  email          String   @unique
  phone          String
  address        String
  photo          String?
  publicId       String?
  parentName     String
  parentsPhone   String
  parentsAddress String
  createdAt      DateTime @default(now())
  active         Boolean  @default(true)

  enrollments Enrollment[]
}

model Course {
  id          Int      @id @default(autoincrement())
  image    String
  publicId  String
  title       String
  description String
  duration    String
  fee      Float
  isActive    Boolean?  @default(true)
  createdAt   DateTime @default(now())

  enrollments Enrollment[]
}

model Payment {
  id        Int      @id @default(autoincrement())
  amount    Float
  reference String   @unique @default(uuid())
  createdAt DateTime @default(now())

enrollment Enrollment @relation(fields: [enrollmentId],references: [id])
enrollmentId Int
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role @default(SUB_ADMIN)
  createdAt DateTime @default(now())
  active    Boolean  @default(true)
  isDemo   Boolean  @default(false)
}

model Enrollment {
  id        Int      @id @default(autoincrement())
  student   Student  @relation(fields: [studentId], references: [id])
  studentId Int
  course    Course   @relation(fields: [courseId], references: [id])
  courseId  Int
  createdAt DateTime @default(now())

  payments   Payment[]
  @@unique([studentId, courseId])
}

model Setting {
  id                          Int       @id @default(1)

  // General
  appName                     String
  appDescription              String?
  contactEmail                String?

  // Branding
  logoUrl                        String?
  logoUrlPublicId                String?
  favicon                     String?
  faviconPublicId             String?
  logoText                    String?

  // Student defaults
  defaultStudentPhoto         String?
  defaultStudentPhotoPublicId String?

  // Dashboard theme
  primaryColor                String?
  secondaryColor              String?
  accentColor                 String?
  backgroundColor             String?
  themeMode                   ThemeMode @default(LIGHT)

  // Regional and financial settings
  timezone                    String?
  currency                    Currency  @default(NGN)

  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt
}

enum Role {
  ADMIN
  SUB_ADMIN
  SUPER_ADMIN
}

enum ThemeMode {
  LIGHT
  DARK
  SYSTEM
}

enum Currency {
  NGN
  USD
  EUR
  GBP
  JPY
  CAD
  AUD
  CHF
  CNY
  SEK
  NZD
}